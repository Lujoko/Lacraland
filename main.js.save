const { app, BrowserWindow, ipcMain } = require('electron');
const path = require('path');
const { Client, Authenticator } = require('minecraft-launcher-core');
const msmc = require('msmc');
const { syncModpack } = require('./sync');

let win;

function createWindow() {
    win = new BrowserWindow({
        width: 1000,
        height: 650,
        resizable: false,
        frame: true,
        autoHideMenuBar: true, // Oculta la barra de menú "File Edit View"
        webPreferences: {
            nodeIntegration: true,
            contextIsolation: false
        }
    });

    win.loadFile('index.html');
}

app.whenReady().then(createWindow);

app.on('window-all-closed', () => {
    if (process.platform !== 'darwin') app.quit();
});

const launcher = new Client();

// --- INICIO DE SESIÓN NO PREMIUM ---
ipcMain.on('login-offline', (event, username) => {
    console.log('[IPC] Iniciando sesión No-Premium:', username);
    const opts = {
        authorization: Authenticator.getAuth(username),
        root: path.join(app.getPath('userData'), 'lacraland_client'),
        version: {
            number: "1.21.1",
            type: "release"
        },
        memory: {
            max: "4G",
            min: "2G"
        }
    };

    startMinecraft(opts);
});

// --- INICIO DE SESIÓN MICROSOFT ---
ipcMain.on('login-microsoft', async () => {
    console.log('[IPC] Abriendo ventana de autenticación Microsoft...');
    try {
        const authManager = new msmc.Auth("select_account");
        const xboxManager = await authManager.launch("electron");
        const token = await xboxManager.getMinecraft();

        console.log('[MSMC] ¡Login completado con éxito! Bienvenido:', token.name);

        const opts = {
            authorization: token.mclc(),
            root: path.join(app.getPath('userData'), 'lacraland_client'),
            version: {
                number: "1.21.1",
                type: "release"
            },
            memory: {
                max: "4G",
                min: "2G"
            }
        };

        startMinecraft(opts);
    } catch (err) {
        console.error("[MSMC ERROR DETALLADO]:", err);
        if (win && !win.isDestroyed()) {
            win.webContents.send('launcher-error', 'Cancelaste o falló el inicio de sesión.');
        }
    }
});

function startMinecraft(opts) {
    launcher.launch(opts);

    launcher.on('debug', (e) => console.log('[DEBUG]', e));
    
    launcher.on('data', (e) => {
        console.log('[DATA]', e);
        if (win && !win.isDestroyed()) {
            win.hide();
        }
        setTimeout(() => {
            app.quit();
        }, 1500);
    });

    launcher.on('progress', (e) => {
        if (win && !win.isDestroyed()) win.webContents.send('progress', e);
    });
    
    launcher.on('close', (e) => {
        if (win && !win.isDestroyed()) win.webContents.send('game-closed', e);
    });
}
