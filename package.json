{
  "name": "lacraland",
  "version": "1.0.0",
  "description": "Launcher personalizado para LacraLand",
  "author": "Lujoko",
  "main": "main.js",
  "scripts": {
    "start": "/usr/bin/electron . --disable-gpu",
    "build:win": "electron-builder --win --x64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lujoko/Lacraland.git"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "fs-extra": "^11.4.0",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.lacraland.launcher",
    "productName": "Lacraland Launcher",
    "icon": "icon.ico",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico"
    }
  }
}
